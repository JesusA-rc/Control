generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum TipoFinanza {
  ingreso
  gasto
}

model Finanza {
  id          Int         @id @default(autoincrement()) @db.UnsignedInt
  tipo        TipoFinanza
  monto       Decimal     @db.Decimal(12, 2)
  descripcion String?     @db.VarChar(255)
  categoria   String?     @db.VarChar(80)
  producto    String?     @db.VarChar(120)
  ingredientes String?    @db.Text
  creadoEn    DateTime    @default(now()) @map("creado_en")

  @@index([tipo], map: "idx_finanzas_tipo")
  @@index([categoria], map: "idx_finanzas_categoria")
  @@index([producto], map: "idx_finanzas_producto")
  @@index([creadoEn], map: "idx_finanzas_creado_en")
  @@map("finanzas")
}
